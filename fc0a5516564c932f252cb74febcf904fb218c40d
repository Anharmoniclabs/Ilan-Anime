<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Anime Motion — Director’s room</title>
<style>
:root{color-scheme:dark;--bg:#111216;--panel:#1b1d23;--line:#34363e;--text:#eeeae0;--muted:#a5a5b0;--lime:#d5f783}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,sans-serif}button,input,textarea,select{font:inherit}button,.upload{cursor:pointer;background:#272a31;border:1px solid var(--line);border-radius:7px;color:var(--text);padding:10px 15px;display:inline-block}button:hover,.upload:hover{border-color:var(--lime)}button:disabled{opacity:.45;cursor:wait}.primary{background:var(--lime);color:#17200c;border-color:var(--lime);font-weight:700}header{padding:20px 32px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:18px}.logo{font-weight:900;font-size:20px;letter-spacing:-1px}.logo span{color:var(--lime)}.tag{font:11px monospace;letter-spacing:2px;color:var(--muted)}.spacer{flex:1}main{display:grid;grid-template-columns:270px 1fr;min-height:calc(100vh - 79px)}aside{border-right:1px solid var(--line);padding:22px 18px}h1{font-size:42px;line-height:1.12;letter-spacing:-2px;font-weight:500;margin:0 0 14px}h2{font-size:17px;margin:0 0 15px}h3{font-size:14px;margin:20px 0 8px}.muted{color:var(--muted)}.small{font-size:12px}label.field{display:block;color:var(--muted);font-size:12px;margin:13px 0 5px}input,textarea,select{width:100%;background:#101115;color:var(--text);border:1px solid var(--line);border-radius:6px;padding:10px}textarea{resize:vertical;min-height:70px}input:focus,textarea:focus,select:focus{outline:1px solid var(--lime)}.content{padding:30px;min-width:0}.intro{display:flex;justify-content:space-between;align-items:flex-start;gap:24px}.eyebrow{color:var(--lime);font:11px monospace;letter-spacing:2px;margin:0 0 16px}.workbench{display:grid;grid-template-columns:minmax(250px,1.2fr) minmax(290px,1fr);gap:22px;margin-top:28px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}.viewer{aspect-ratio:16/10;background:#08090b;display:flex;align-items:center;justify-content:center;border-radius:8px;overflow:hidden;position:relative}.viewer img,.viewer video{max-width:100%;max-height:100%;width:100%;height:100%;object-fit:contain}.empty{padding:30px;text-align:center;max-width:480px}.empty .symbol{font-size:64px;color:var(--lime);line-height:1.2;margin-bottom:20px}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.row>*{flex-shrink:0}.shotlist{display:flex;gap:12px;overflow:auto;padding:15px 0}.shotcard{min-width:155px;width:155px;text-align:left;padding:8px;background:#181a20}.shotcard.active{border-color:var(--lime)}.shotcard img{width:137px;height:78px;object-fit:cover;border-radius:4px}.shotcard strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badge{font:10px monospace;color:var(--lime);text-transform:uppercase}.status{padding:12px 18px;border:1px solid var(--line);border-radius:8px;background:#22252c;margin-bottom:20px;white-space:pre-wrap}.status.error{border-color:#ec9176;color:#ffc5b4}.status:empty{display:none}.scrub{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;margin:15px 0}.scrub input{padding:0}.checks label{display:block;padding:5px 0;color:var(--muted)}input[type=checkbox]{width:auto;margin-right:7px;accent-color:var(--lime)}.contact{width:100%;margin-top:15px;border-radius:6px}.toolbar{margin:16px 0}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.rule{height:1px;background:var(--line);margin:22px 0}.hidden{display:none!important}pre{white-space:pre-wrap;font:12px/1.6 monospace;color:#cdd1c3;max-height:300px;overflow:auto}.timeline-head{display:flex;align-items:center;gap:12px;margin-top:28px}.notice{border-left:2px solid var(--lime);padding-left:12px}.busy{color:var(--lime)}@media(max-width:1100px){main{grid-template-columns:230px 1fr}.workbench{grid-template-columns:1fr}}@media(max-width:700px){main{display:block}aside{border-right:0;border-bottom:1px solid var(--line)}header{padding:16px}.content{padding:20px}.intro{display:block}h1{font-size:34px}}
</style></head><body>
<header><div class="logo">ANIME<span> / </span>MOTION</div><div class="tag">DIRECTOR’S ROOM</div><div class="spacer"></div><button id="save">Save project</button><button id="export" class="primary">Export film ↗</button></header>
<main><aside><div class="eyebrow">01 / FILM BIBLE</div><h2>One world. Every shot.</h2><p class="muted small">These details accompany every generation. Use consistent source art for each character and scene.</p>
<label class="field" for="title">Film title</label><input id="title">
<label class="field" for="characters">Character identity</label><textarea id="characters" placeholder="Face, hair, costume, proportions, signature details…"></textarea>
<label class="field" for="world">World & lighting</label><textarea id="world" placeholder="Setting, time, palette, light direction…"></textarea>
<label class="field" for="style">Animation direction</label><textarea id="style" rows="5"></textarea>
<div class="rule"></div><div class="eyebrow">RENDER ENGINE</div><strong>Wan 2.2 · Image to video</strong><p id="connection" class="muted small"></p><p class="small muted">Cloud renders use your fal account and incur provider charges. Importing and reviewing clips is local.</p><div class="rule"></div><p class="small muted">Sora 2’s API was retired September 24, 2026. You can import existing Sora clips or clips from other tools.</p><p class="small"><a href="https://developers.openai.com/api/docs/deprecations" target="_blank" rel="noreferrer" style="color:var(--muted)">OpenAI availability notice ↗</a></p></aside>
<section class="content"><div id="status" class="status" role="status" aria-live="polite"></div><div class="intro"><div><div class="eyebrow">02 / SHOT DIRECTION</div><h1>Give your images<br>something to do.</h1><p class="muted">Anticipation. Action. Follow-through. A film built one intentional shot at a time.</p></div><label class="upload primary">＋ Add your images<input class="hidden" id="images" type="file" multiple accept="image/png,image/jpeg"></label></div>
<div class="workbench"><div><div class="panel"><div class="row"><h2 id="viewerTitle">Your first moving scene starts here</h2><div class="spacer"></div><span id="takeBadge" class="badge">NO SHOTS YET</span></div><div id="viewer" class="viewer"><div class="empty"><div class="symbol">◈</div><strong>Bring the characters. Direct the action.</strong><p class="muted">Add a PNG or JPEG, describe how the subject moves, and render a real video take.</p></div></div><div id="previewTools" class="hidden"><div class="row toolbar"><button id="source">Reference</button><button id="play">Play take</button><button id="frames">Inspect frames</button><button id="framezip">Download frames</button><select id="takes" aria-label="Take" style="width:auto;max-width:180px"></select></div><div id="scrubber" class="scrub hidden"><span>Frame</span><input id="frame" type="range" min="1" max="1" value="1"><span id="frameLabel">1 / 1</span></div><p id="motionNote" class="muted small"></p><img id="contact" class="contact hidden" alt="Twelve-frame contact sheet"></div></div><div id="review" class="panel hidden" style="margin-top:20px"><div class="eyebrow">03 / QUALITY REVIEW</div><h2>Watch the movement. Check the drawings.</h2><div class="checks"><label><input type="checkbox" id="body_motion">The subject performs the intended body action</label><label><input type="checkbox" id="identity">Face, costume and proportions stay consistent</label><label><input type="checkbox" id="anatomy">Anatomy and motion hold up frame by frame</label><label><input type="checkbox" id="continuity">The shot connects to its neighbors</label></div><label class="field" for="notes">Review notes</label><textarea id="notes" placeholder="What worked? What needs another take?"></textarea><button id="approve" class="primary" style="margin-top:14px">Use this take in the film</button></div></div>
<div class="panel"><div class="row"><h2>Choreograph the shot</h2><div class="spacer"></div><span class="badge">ACTION FIRST</span></div><div id="directionEmpty" class="muted">Add an image to open its shot brief.</div><div id="direction" class="hidden">
<label class="field" for="shotTitle">Shot name</label><input id="shotTitle">
<label class="field" for="start">01 · Starting pose / anticipation</label><textarea id="start" placeholder="She plants her back foot, drops her center of gravity and pulls her right arm back."></textarea>
<label class="field" for="action">02 · Main body action</label><textarea id="action" placeholder="She drives forward, rotates her torso and swings her arm in a clear arc."></textarea>
<label class="field" for="end">03 · End pose / follow-through</label><textarea id="end" placeholder="She lands with weight on the front foot; her sleeve catches up as her gaze locks right."></textarea>
<div class="two"><div><label class="field" for="secondary">Secondary motion</label><textarea id="secondary"></textarea></div><div><label class="field" for="camera">Camera</label><textarea id="camera"></textarea></div></div>
<label class="field" for="continuity">Connection to the next shot</label><textarea id="continuity"></textarea>
<label class="field" for="seconds">Target seconds (2–10)</label><input id="seconds" type="number" min="2" max="10" step="1">
<p class="muted small">The image anchors the opening. Action beats guide generation; precise poses and identity still need review.</p>
<div class="row toolbar"><button id="render" class="primary">Generate take · paid</button><button id="poll">Check render</button></div><div class="row"><label class="upload">Import video take<input class="hidden" id="clip" type="file" accept="video/mp4,video/quicktime,video/webm"></label><button id="prompt">View prompt</button></div><pre id="promptText" class="hidden"></pre></div></div></div>
<div class="timeline-head"><div class="eyebrow" style="margin:0">04 / SEQUENCE</div><span id="sequenceInfo" class="muted small">0 shots</span><div class="spacer"></div><button id="left">← Move shot</button><button id="right">Move shot →</button></div><div id="shotlist" class="shotlist"></div><div id="download"></div><p class="muted small">Exports a silent picture edit. Original takes and all decoded PNG frames stay in your workspace.</p>
</section></main>
<script>
let project,selected=null,configured=false,busy=false;const $=id=>document.getElementById(id);const fields=['start','action','end','secondary','camera','continuity','seconds'];const checks=['body_motion','identity','anatomy','continuity'];
const shot=()=>project.shots.find(s=>s.id===selected);const take=()=>shot()?.takes[shot().active];const media=p=>'/media/'+p.split('/').map(encodeURIComponent).join('/');
function notice(text,error=false){$('status').textContent=text;$('status').classList.toggle('error',error)}
async function request(name,data){const r=await fetch('/api/'+name,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const v=await r.json();if(!r.ok)throw Error(v.error);return v}
async function task(fn){if(busy)return;busy=true;document.querySelectorAll('button').forEach(b=>b.disabled=true);try{await fn()}catch(e){notice(e.message,true)}finally{busy=false;document.querySelectorAll('button').forEach(b=>b.disabled=false)}}
function capture(){for(const k of ['title','characters','world','style'])project[k]=$(k).value;const s=shot();if(s){s.title=$('shotTitle').value;for(const k of fields)s[k]=$(k).value}}
async function save(){capture();project=await request('save',project)}
function showSource(){const s=shot();if(!s)return;$('viewer').replaceChildren();const img=document.createElement('img');img.src=media(s.image);img.alt=s.title+' reference';$('viewer').append(img);$('scrubber').classList.add('hidden')}
function showVideo(){const t=take();if(!t?.frame_count)return showSource();$('viewer').replaceChildren();const v=document.createElement('video');v.src=media(t.folder+'/video.mp4');v.controls=true;v.loop=true;v.playsInline=true;$('viewer').append(v);$('scrubber').classList.add('hidden')}
function showFrame(){const t=take();if(!t?.frame_count)return;const n=Number($('frame').value);$('viewer').replaceChildren();const img=document.createElement('img');img.src=media(t.folder+'/frames/'+String(n).padStart(6,'0')+'.png');img.alt='Frame '+n;$('viewer').append(img);$('scrubber').classList.remove('hidden');$('frameLabel').textContent=n+' / '+t.frame_count}
function paint(){for(const k of ['title','characters','world','style'])$(k).value=project[k];$('connection').textContent=configured?'● API key configured on this machine':'○ Set FAL_KEY before launching to enable cloud rendering.';const s=shot(),t=take();$('direction').classList.toggle('hidden',!s);$('directionEmpty').classList.toggle('hidden',!!s);$('previewTools').classList.toggle('hidden',!s);$('review').classList.toggle('hidden',!t?.frame_count);$('contact').classList.toggle('hidden',!t?.frame_count);$('promptText').classList.add('hidden');$('sequenceInfo').textContent=project.shots.length+' shots · '+project.shots.filter(s=>s.takes[s.active]?.approved).length+' selected for export';$('takeBadge').textContent=t?.status||'REFERENCE';
if(s){$('viewerTitle').textContent=s.title;$('shotTitle').value=s.title;for(const k of fields)$(k).value=s[k];$('takes').replaceChildren();s.takes.forEach((t,i)=>{const o=new Option('Take '+(i+1)+' · '+t.status,i);$('takes').add(o)});$('takes').value=s.active;for(const k of checks)$(k).checked=!!t?.review?.[k];$('notes').value=t?.notes||'';if(t?.frame_count){$('frame').max=t.frame_count;$('frame').value=1;$('contact').src=media(t.folder+'/contact.jpg');$('motionNote').textContent=(t.motion_warning?'⚠ Mostly frozen frames detected. ':'')+t.frame_count+' decoded frames · '+t.media.seconds.toFixed(2)+'s. Pixel movement is only a screening signal; check actual body action.';showVideo()}else{$('motionNote').textContent=t?'Generation status: '+t.status+'. Use Check render to retrieve it.':'';showSource()}}
$('shotlist').replaceChildren();project.shots.forEach((s,i)=>{const b=document.createElement('button');b.className='shotcard'+(s.id===selected?' active':'');const img=document.createElement('img');img.src=media(s.image);img.alt=s.title;const title=document.createElement('strong');title.textContent=String(i+1).padStart(2,'0')+' / '+s.title;const meta=document.createElement('span');meta.className='badge';meta.textContent=s.takes[s.active]?.status||'needs direction';b.append(img,title,meta);b.onclick=()=>task(async()=>{await save();selected=s.id;paint()});$('shotlist').append(b)});$('download').replaceChildren();if(project.export){const a=document.createElement('a');a.href=media(project.export);a.textContent='Download latest film ↗';a.className='upload primary';a.download='anime-motion.mp4';$('download').append(a)}}
function read(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result.split(',')[1]);r.onerror=reject;r.readAsDataURL(file)})}
$('images').onchange=e=>task(async()=>{const files=[...e.target.files];await save();for(const f of files){if(f.size>8e6)throw Error('Images must be under 8 MB.');notice('Adding '+f.name+'…');project=await request('upload',{name:f.name,data:await read(f)});selected=project.shots.at(-1).id}paint();notice('Images added. Fill in the film bible and the three action beats.');e.target.value='' });
$('save').onclick=()=>task(async()=>{await save();paint();notice('Project saved locally.')});
$('render').onclick=()=>task(async()=>{await save();notice('Submitting one paid take. This sends the selected image to fal.');project=await request('render',{id:selected});paint();notice('Take submitted. You can close the studio and check this same job later. No automatic rerenders.')});
$('poll').onclick=()=>task(async()=>{await save();notice('Checking the existing render and extracting frames if ready…');project=await request('poll',{id:selected});paint();notice('Render status: '+take().status)});
$('clip').onchange=e=>task(async()=>{const f=e.target.files[0];if(!f)return;if(f.size>90e6)throw Error('Clips must be under 90 MB and 30 seconds.');await save();notice('Importing clip and extracting every frame…');project=await request('import',{id:selected,data:await read(f),name:f.name});paint();notice('Take imported. Review the action and continuity.');e.target.value='' });
$('prompt').onclick=()=>task(async()=>{await save();const r=await request('prompt',{id:selected});$('promptText').textContent=r.prompt;$('promptText').classList.remove('hidden')});
$('approve').onclick=()=>task(async()=>{const review=Object.fromEntries(checks.map(k=>[k,$(k).checked]));const notes=$('notes').value;await save();project=await request('approve',{id:selected,...review,notes});paint();notice('Take selected for the film.')});
$('takes').onchange=e=>task(async()=>{const index=Number(e.target.value);await save();project=await request('select',{id:selected,index});paint()});
async function move(delta){await save();const i=project.shots.findIndex(s=>s.id===selected),j=i+delta;if(i<0||j<0||j>=project.shots.length)return;[project.shots[i],project.shots[j]]=[project.shots[j],project.shots[i]];project=await request('save',project);paint();notice('Shot order updated. Check continuity across the new cut.')}
$('left').onclick=()=>task(()=>move(-1));$('right').onclick=()=>task(()=>move(1));$('source').onclick=showSource;$('play').onclick=showVideo;$('frames').onclick=showFrame;$('frame').oninput=showFrame;
$('framezip').onclick=()=>task(async()=>{notice('Packing original decoded frames…');const r=await request('framezip',{id:selected});const a=document.createElement('a');a.href=media(r.url);a.download='shot-frames.zip';a.click();notice('Frame archive ready.');});
$('export').onclick=()=>task(async()=>{await save();notice('Assembling the reviewed takes…');project=await request('export',{});paint();notice('Film exported. Download it below the sequence.')});
task(async()=>{const r=await fetch('/api/project');if(!r.ok)throw Error('Could not load project');const d=await r.json();project=d.project;configured=d.configured;selected=project.shots[0]?.id;paint()});
</script></body></html>
