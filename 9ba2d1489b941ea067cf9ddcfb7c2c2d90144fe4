# Prepared recipe, NOT GPU-tested and NOT a trained adapter.
# Export only approved training entries into dataset/export/train first.
# Keep dataset/export/validation outside the trainer's folder_path.
# Based on https://ostris.com/docs/ai-toolkit/models/qwen-image
job: extension
config:
  name: cemi_qwen_style_pilot_v1
  process:
    - type: sd_trainer
      training_folder: output
      device: cuda:0
      network:
        type: lora
        linear: 16
        linear_alpha: 16
      save:
        dtype: float16
        save_every: 100
        max_step_saves_to_keep: 3
      datasets:
        - folder_path: /workspace/HeraldsOfTheCemi/dataset/export/train
          caption_ext: txt
          caption_dropout_rate: 0.05
          cache_latents_to_disk: true
          resolution: [512, 768, 1024]
      train:
        batch_size: 1
        steps: 500
        gradient_checkpointing: true
        noise_scheduler: flowmatch
        timestep_type: weighted
        optimizer: adamw8bit
        lr: 0.0001
        dtype: bf16
        cache_text_embeddings: true
      model:
        name_or_path: Qwen/Qwen-Image
        arch: qwen_image
        quantize: true
        qtype: qfloat8
        quantize_te: true
        qtype_te: qfloat8
        low_vram: true
      sample:
        sampler: flowmatch
        sample_every: 100
        width: 1024
        height: 1024
        guidance_scale: 3
        sample_steps: 25
        prompts:
          - "cemi_lm_style, adult Caribbean character with tired expressive eyes, graphite crosshatching over restrained rich color, no lettering"
          - "cemi_lm_style, lived-in Bronx electronics workshop at night, pencil grain, indigo and amber light, no people or lettering"
          - "cemi_lm_style, Santo Domingo street after rain, researched architecture, organic contours and watercolor, no lettering"
