{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anharmoniclabs/animestudio/production/schemas/asset-record.schema.json",
  "title": "AnimeStudio immutable asset version",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "version", "path", "sha256", "kind", "mode", "shots", "provenance", "continuity", "initial_state", "supersedes"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "version": {"type": "integer", "minimum": 1},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[?#\\\\]).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "mode": {"enum": ["source", "reference", "work-in-progress", "production"]},
    "shots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,39}$"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "creator", "license", "source_assets", "notes"],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "license": {"type": "string", "minLength": 1},
        "source_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        },
        "notes": {"type": "string", "minLength": 1},
        "public_source_url": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$"}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_ids", "costume_ids", "prop_ids", "time", "location"],
      "properties": {
        "character_ids": {"$ref": "#/$defs/string_set"},
        "costume_ids": {"$ref": "#/$defs/string_set"},
        "prop_ids": {"$ref": "#/$defs/string_set"},
        "time": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "initial_state": {"enum": ["exploratory", "submitted"]},
    "supersedes": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
