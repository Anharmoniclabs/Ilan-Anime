{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anharmoniclabs/animestudio/production/schemas/asset-registry.schema.json",
  "title": "AnimeStudio append-only asset registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "action", "previous_event_hash", "payload", "event_hash"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "at": {"type": "string", "format": "date-time"},
        "action": {"enum": ["register", "transition", "link-final", "unlink-final"]},
        "previous_event_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "payload": {"type": "object"},
        "event_hash": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "register"}}},
          "then": {"properties": {"payload": {"$ref": "asset-record.schema.json"}}}
        },
        {
          "if": {"properties": {"action": {"const": "transition"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "version", "from", "to", "approval"],
                "properties": {
                  "asset_id": {"$ref": "#/$defs/id"},
                  "version": {"type": "integer", "minimum": 1},
                  "from": {"$ref": "#/$defs/state"},
                  "to": {"$ref": "#/$defs/state"},
                  "approval": {"oneOf": [{"type": "null"}, {"$ref": "approval-record.schema.json"}]}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "link-final"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["use_id", "asset_id", "version", "shots"],
                "properties": {
                  "use_id": {"$ref": "#/$defs/id"},
                  "asset_id": {"$ref": "#/$defs/id"},
                  "version": {"type": "integer", "minimum": 1},
                  "shots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,39}$"}}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "unlink-final"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["use_id", "reason"],
                "properties": {
                  "use_id": {"$ref": "#/$defs/id"},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      ]
    },
    "asset_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "state": {
      "enum": ["exploratory", "submitted", "technical-approved", "author-approved", "canonical", "rejected"]
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_ids", "costume_ids", "prop_ids", "time", "location"],
      "properties": {
        "character_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "costume_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prop_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "time": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      }
    }
  }
}
