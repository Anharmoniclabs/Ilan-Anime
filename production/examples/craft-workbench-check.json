{
  "description": "Technical engine fixtures; not episode artwork",
  "outputs": [
    "paint.pcraft",
    "paint.png",
    "prop.svg",
    "prop.pdf",
    "developed.png",
    "board.designcraft",
    "board.png"
  ],
  "steps": [
    {
      "app": "photocraft",
      "tool": "doc_new",
      "arguments": {
        "width": 320,
        "height": 180,
        "name": "Ilan technical canvas",
        "background": "#17213c"
      }
    },
    {
      "app": "photocraft",
      "tool": "doc_save",
      "arguments": {
        "path": "${OUT}/paint.pcraft"
      }
    },
    {
      "app": "photocraft",
      "tool": "doc_export",
      "arguments": {
        "path": "${OUT}/paint.png"
      }
    },
    {
      "app": "vectorcraft",
      "tool": "draw_shape",
      "arguments": {
        "shape": "ellipse",
        "x": 20,
        "y": 20,
        "width": 120,
        "height": 120,
        "fill": "#d9aa55"
      }
    },
    {
      "app": "vectorcraft",
      "tool": "export",
      "arguments": {
        "path": "${OUT}/prop.svg",
        "format": "svg"
      }
    },
    {
      "app": "vectorcraft",
      "tool": "export",
      "arguments": {
        "path": "${OUT}/prop.pdf",
        "format": "pdf"
      }
    },
    {
      "app": "lightcraft",
      "tool": "import",
      "arguments": {
        "paths": [
          "${OUT}/paint.png"
        ]
      }
    },
    {
      "app": "lightcraft",
      "tool": "export",
      "arguments": {
        "path": "${OUT}/developed.png",
        "longEdge": 320
      }
    },
    {
      "app": "designcraft",
      "tool": "new_document",
      "arguments": {
        "title": "Ilan technical layout",
        "width": 320,
        "height": 180,
        "pages": 1
      }
    },
    {
      "app": "designcraft",
      "tool": "save_document",
      "arguments": {
        "path": "${OUT}/board.designcraft"
      }
    },
    {
      "app": "designcraft",
      "tool": "export_png",
      "arguments": {
        "path": "${OUT}/board.png",
        "scale": 1
      }
    },
    {
      "app": "pdfcraft",
      "tool": "doc_open",
      "arguments": {
        "path": "${OUT}/prop.pdf"
      }
    },
    {
      "app": "pdfcraft",
      "tool": "doc_list",
      "arguments": {}
    }
  ]
}
