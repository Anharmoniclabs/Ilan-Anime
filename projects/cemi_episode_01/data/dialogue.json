      "shot_frames": 192,
      "max_seconds": 8.0
    },
    {
      "id": "S12-09-L01",
      "shot": "S12-09",
      "text": "You went somewhere.",
      "speaker": null,
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 18456,
      "shot_frames": 432,
      "max_seconds": 18.0
    },
    {
      "id": "S12-09-L02",
      "shot": "S12-09",
      "text": "That wasn't a tired thing.",
      "speaker": null,
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 18456,
      "shot_frames": 432,
      "max_seconds": 18.0
    },
    {
      "id": "S12-09-L03",
