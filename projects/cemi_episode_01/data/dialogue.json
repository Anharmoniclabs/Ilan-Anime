    },
    {
      "id": "S14-09-L03",
      "shot": "S14-09",
      "text": "That's a sentence you write when you're looking for the kids who react. We need the screening records.",
      "speaker": null,
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 24264,
      "shot_frames": 216,
      "max_seconds": 9.0
    },
    {
      "id": "S14-10-L01",
      "shot": "S14-10",
      "text": "Listen,",
      "speaker": "Mikey",
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 24480,
      "shot_frames": 360,
      "max_seconds": 15.0
    },
    {
      "id": "S14-11-L01",
      "shot": "S14-11",
      "text": "Every shell on this screen is trying to predict something. The grant, the playlists, the permits. Somebody's got a model of this block, and I think they've been checking it since you were six. Nineteen years.",
      "speaker": null,
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 24840,
      "shot_frames": 480,
      "max_seconds": 20.0
    },
    {
      "id": "S14-11-L02",
      "shot": "S14-11",
      "text": "We need to find out what they did with the children who kept reacting. Don't answer the email. Don't delete it. And don't walk home past the bodega.",
      "speaker": "kid",
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 24840,
      "shot_frames": 480,
      "max_seconds": 20.0
    },
    {
      "id": "S14-11-L03",
      "shot": "S14-11",
      "text": "Why?",
      "speaker": null,
      "speaker_inferred": true,
      "voiceover": false,
      "field": "action",
      "shot_start_frame": 24840,
      "shot_frames": 480,
      "max_seconds": 20.0
    },
    {
      "id": "S14-11-L04",
      "shot": "S14-11",
      "text": "Because I just spent an hour telling you I don't believe in your loop, and I'd like to still be wrong tomorrow. Also eat a vegetable. Platanitos don't count.",
      "speaker": null,
      "speaker_inferred": true,
      "voiceover": false,
