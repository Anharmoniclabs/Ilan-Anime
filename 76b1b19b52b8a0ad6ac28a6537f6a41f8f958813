  {
    "description": "A layer's property tree (transform, masks, effects, text, shape contents, ...): every node has a `path` usable with get_property/set_property/add_keyframe, plus uid, match id, name, type, value at `time`, keyframes and expression. `flat: true` returns just a list of {path, type, value, keys, expression} (compact).",
    "inputSchema": {
      "properties": {
        "comp": {
          "description": "Composition item id or name; omit for the active comp.",
          "type": [
            "integer",
            "string"
          ]
        },
        "depth": {
          "description": "Group depth to expand (default all).",
          "type": "integer"
        },
        "flat": {
          "description": "Return a flat list of properties instead of the tree.",
          "type": "boolean"
        },
        "layer": {
          "description": "Layer id (from get_comp), \"#n\" (1-based index from the top) or layer name.",
          "type": [
            "integer",
            "string"
          ]
        },
        "time": {
          "description": "Comp time in seconds for values (default: current time).",
          "type": "number"
        }
      },
      "required": [
        "layer"
      ],
      "type": "object"
    },
    "name": "get_layer"
  },
  {
    "description": "Read one property: type, value at `time` (comp seconds; default the current time), whether it is animated, its keyframes (time, value, in/out interpolation) and expression.",
    "inputSchema": {
      "properties": {
        "comp": {
          "description": "Composition item id or name; omit for the active comp.",
          "type": [
            "integer",
            "string"
          ]
        },
        "layer": {
          "description": "Layer id (from get_comp), \"#n\" (1-based index from the top) or layer name.",
          "type": [
            "integer",
            "string"
          ]
        },
        "path": {
          "description": "Property path from get_layer: match ids joined by `/`, `#n` for the nth child, or `@uid`. E.g. `transform/position`, `transform/opacity`, `transform/scale`, `transform/rotation`, `effects/#1/blurriness`, `masks/#1/feather`, `@57`.",
          "type": "string"
        },
        "time": {
          "description": "Comp time in seconds.",
          "type": "number"
        }
      },
      "required": [
        "layer",
        "path"
      ],
      "type": "object"
    },
    "name": "get_property"
  },
  {
    "description": "Set a property. Without `time`: sets the static value (or a key at the current time if already animated). With `time`: adds/replaces a keyframe there, turning the stopwatch on. `expression` sets an After Effects-style JS expression (\"\" removes it). Returns the property as get_property does. Examples: {\"layer\":3,\"path\":\"transform/opacity\",\"value\":50}; {\"layer\":\"Title\",\"path\":\"transform/position\",\"value\":[200,540],\"time\":0}; {\"layer\":3,\"path\":\"transform/rotation\",\"expression\":\"time*90\"}.",
    "inputSchema": {
      "properties": {
        "comp": {
          "description": "Composition item id or name; omit for the active comp.",
          "type": [
            "integer",
            "string"
          ]
        },
        "expression": {
          "description": "Expression text; empty string removes the expression.",
          "type": "string"
        },
        "layer": {
          "description": "Layer id (from get_comp), \"#n\" (1-based index from the top) or layer name.",
          "type": [
            "integer",
            "string"
          ]
        },
        "path": {
          "description": "Property path from get_layer: match ids joined by `/`, `#n` for the nth child, or `@uid`. E.g. `transform/position`, `transform/opacity`, `transform/scale`, `transform/rotation`, `effects/#1/blurriness`, `masks/#1/feather`, `@57`.",
          "type": "string"
        },
        "time": {
          "description": "Keyframe time in seconds (layer time; equals comp time unless the layer is offset/stretched).",
          "type": "number"
        },
        "value": {
          "description": "Number for 1-D properties (50), array for vectors ([960,540]), \"#rrggbb\" or [r,g,b,a] (0-1) for colours, bool for checkboxes, string for text/menus."
        }
      },
      "required": [
        "layer",
        "path"
      ],
      "type": "object"
    },
    "name": "set_property"
  },
  {
