    "inputSchema": {
      "properties": {
        "comp": {
          "description": "Composition item id or name; omit for the active comp.",
          "type": [
            "integer",
            "string"
          ]
        },
        "interpolation": {
          "enum": [
            "linear",
            "bezier",
            "hold",
            "easyEase",
            "easyEaseIn",
            "easyEaseOut"
          ],
          "type": "string"
        },
        "keys": {
          "description": "Several keys at once.",
          "items": {
            "properties": {
              "time": {
                "type": "number"
              },
              "value": {
                "description": "Number for 1-D properties (50), array for vectors ([960,540]), \"#rrggbb\" or [r,g,b,a] (0-1) for colours, bool for checkboxes, string for text/menus."
              }
            },
            "required": [
              "time"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "layer": {
          "description": "Layer id (from get_comp), \"#n\" (1-based index from the top) or layer name.",
          "type": [
            "integer",
            "string"
          ]
        },
        "path": {
          "description": "Property path from get_layer: match ids joined by `/`, `#n` for the nth child, or `@uid`. E.g. `transform/position`, `transform/opacity`, `transform/scale`, `transform/rotation`, `effects/#1/blurriness`, `masks/#1/feather`, `@57`.",
          "type": "string"
        },
        "time": {
          "description": "Key time in seconds (layer time).",
          "type": "number"
        },
        "value": {
          "description": "Number for 1-D properties (50), array for vectors ([960,540]), \"#rrggbb\" or [r,g,b,a] (0-1) for colours, bool for checkboxes, string for text/menus."
        }
      },
      "required": [
        "layer",
        "path"
      ],
      "type": "object"
    },
    "name": "add_keyframe"
  },
  {
    "description": "Apply an effect to a layer and optionally set its parameters in one undoable call. `effect` is an id (`ec.blur.gaussian`) or After Effects name (`Gaussian Blur`; see list_effects); `values` maps parameter ids to values, e.g. {\"blurriness\": 12}. One undo step; if a value fails, nothing is applied. Returns the instance `path` (`effects/#n`, for set_property / add_keyframe) and its parameters with their paths and current values.",
    "inputSchema": {
      "properties": {
        "comp": {
          "description": "Composition item id or name; omit for the active comp.",
          "type": [
            "integer",
            "string"
          ]
        },
        "effect": {
          "description": "Effect id or name, e.g. `Gaussian Blur`, `Glow`, `Curves`, `ec.color.levels`.",
          "type": "string"
        },
        "layer": {
          "description": "Layer id (from get_comp), \"#n\" (1-based index from the top) or layer name.",
          "type": [
            "integer",
            "string"
          ]
        },
        "values": {
          "additionalProperties": true,
          "description": "Parameter id -> value (ids are in the returned `params` paths), e.g. {\"blurriness\": 12}.",
          "type": "object"
        }
      },
      "required": [
        "layer",
        "effect"
      ],
      "type": "object"
    },
    "name": "add_effect"
  },
